generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String   @id @default(cuid())
  name        String?
  email       String?  @unique
  phone       String   @unique
  role        Role     @default(LANDLORD)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  properties  Property[]
  tenants     Tenant[]
  payments    Payment[]

  @@index([phone])
  @@index([email])
  @@index([role])
  @@index([isActive])
}

model Property {
  id          String   @id @default(cuid())
  name        String
  location    String
  unitCount   Int      @default(1)
  landlordId  String
  landlord    User     @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  tenants     Tenant[]
  payments    Payment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([landlordId])
  @@index([name])
}

model Tenant {
  id          String   @id @default(cuid())
  fullName    String
  phone       String
  unitNumber  String
  rentAmount  Float
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  landlordId  String
  landlord    User     @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  payments    Payment[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
  @@index([landlordId])
  @@index([phone])
  @@index([propertyId, isActive])
}

model Payment {
  id               String        @id @default(cuid())
  mpesaReceipt     String?       @unique
  amount           Float
  phoneNumber      String
  status           PaymentStatus @default(PENDING)
  paidAt           DateTime?
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId       String
  property         Property      @relation(fields: [propertyId], references: [id])
  landlordId       String
  landlord         User          @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tenantId])
  @@index([propertyId])
  @@index([landlordId])
  @@index([status])
  @@index([paidAt])
  @@index([mpesaReceipt])
  @@index([phoneNumber])
  @@index([landlordId, status])
  @@index([tenantId, status])
  @@index([status, paidAt])
}

enum Role {
  ADMIN
  LANDLORD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
