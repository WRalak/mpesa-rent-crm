generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String?
  email       String?  @unique
  phone       String   @unique
  role        Role     @default(LANDLORD)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  properties  Property[]
  tenants     Tenant[]
  payments    Payment[]
}

model Property {
  id          String   @id @default(cuid())
  name        String
  location    String
  unitCount   Int      @default(0)
  landlordId  String
  landlord    User     @relation(fields: [landlordId], references: [id])
  tenants     Tenant[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tenant {
  id          String   @id @default(cuid())
  fullName    String
  phone       String
  unitNumber  String
  rentAmount  Decimal  @db.Decimal(10, 2)
  propertyId  String
  landlordId  String
  property    Property @relation(fields: [propertyId], references: [id])
  landlord    User     @relation(fields: [landlordId], references: [id])
  payments    Payment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id               String        @id @default(cuid())
  mpesaReceipt     String?       @unique
  amount           Decimal       @db.Decimal(10, 2)
  phoneNumber      String
  status           PaymentStatus @default(PENDING)
  paidAt           DateTime?
  tenantId         String
  landlordId       String
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  landlord         User          @relation(fields: [landlordId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

enum Role {
  ADMIN
  LANDLORD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
